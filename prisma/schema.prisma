// Urban Noor — database schema (PostgreSQL on Supabase)
// Prices are stored as whole rupees (Int). Razorpay amounts are converted to paise (x100).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (runtime)
  directUrl = env("DIRECT_URL")   // direct connection (migrations)
}

enum Role {
  CUSTOMER
  ADMIN
}

enum Gender {
  MEN
  WOMEN
  UNISEX
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED
}

enum DiscountType {
  PERCENT
  FLAT
}

model User {
  id           String               @id @default(cuid())
  name         String
  email        String               @unique
  phone        String?
  passwordHash String
  role         Role                 @default(CUSTOMER)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  addresses    Address[]
  orders       Order[]
  cart         Cart?
  wishlist     WishlistItem[]
  resetTokens  PasswordResetToken[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  products    Product[]
}

model Product {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  description  String         @db.Text
  gender       Gender         @default(UNISEX)
  categoryId   String
  category     Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  price        Int
  mrp          Int
  stock        Int            @default(0)
  sku          String?        @unique
  material     String?
  tags         String[]
  isFeatured   Boolean        @default(false)
  isNewArrival Boolean        @default(false)
  isBestSeller Boolean        @default(false)
  isActive     Boolean        @default(true)
  soldCount    Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  images       ProductImage[]
  cartItems    CartItem[]
  wishlist     WishlistItem[]
  orderItems   OrderItem[]

  @@index([categoryId])
  @@index([gender])
  @@index([createdAt])
  @@index([isActive])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int     @default(0)

  @@index([productId])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int     @default(1)

  @@unique([cartId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String? // null = guest order
  user            User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName    String
  email           String
  phone           String
  shipName        String
  shipPhone       String
  line1           String
  line2           String?
  city            String
  state           String
  pincode         String
  subtotal        Int
  shippingFee     Int
  discount        Int         @default(0)
  total           Int
  couponCode      String?
  status          OrderStatus @default(PENDING)
  courier         String?
  trackingNumber  String?
  razorpayOrderId String?     @unique
  paidAt          DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
  payments        Payment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([email])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  // snapshot at purchase time
  name      String
  image     String?
  price     Int
  quantity  Int
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  razorpayOrderId   String
  razorpayPaymentId String?       @unique
  signature         String?
  method            String?
  amount            Int // in paise
  status            PaymentStatus @default(CREATED)
  errorReason       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
  @@index([razorpayOrderId])
}

model Coupon {
  id          String       @id @default(cuid())
  code        String       @unique
  type        DiscountType @default(PERCENT)
  value       Int
  minOrder    Int          @default(0)
  maxDiscount Int?
  usageLimit  Int?
  usedCount   Int          @default(0)
  expiresAt   DateTime?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
}

// Single row (id = "store") holding editable store settings
model Setting {
  id                    String   @id @default("store")
  tagline               String   @default("Shine Without Limits")
  announcement          String   @default("Free shipping on orders above ₹999 ✦ Anti-tarnish & skin-friendly ✦ Easy 7-day returns")
  heroTitle             String   @default("Shine Without Limits")
  heroSubtitle          String   @default("Statement jewellery for him and her — crafted to turn every moment into an occasion.")
  heroImage             String   @default("/seed/hero.jpg")
  shippingFee           Int      @default(79)
  freeShippingThreshold Int      @default(999)
  whatsappNumber        String   @default("919999999999")
  contactEmail          String   @default("hello@urbannoor.in")
  contactPhone          String   @default("+91 99999 99999")
  address               String   @default("Jaipur, Rajasthan, India")
  instagramUrl          String   @default("https://instagram.com/")
  facebookUrl           String   @default("https://facebook.com/")
  updatedAt             DateTime @updatedAt
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}
